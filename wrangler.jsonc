{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Dedicated, isolated Worker for this project. Do not reuse names/resources from other projects.
  "name": "youtube-automation-platform",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Workers AI (free daily allowance): optional image + text-to-speech providers for the renderer.
  "ai": { "binding": "AI" },
  // Catch-up check every 15 minutes: makes sure all 3 daily videos get made (retries skipped/failed ones).
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "youtube-automation-db",
      "database_id": "15ee6196-efbc-4356-906f-e32a8d9e0465",
      "migrations_dir": "migrations",
    },
  ],
}
